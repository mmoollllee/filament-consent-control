{
    "name": "mmoollllee/filament-consent-control",
    "description": "Filament admin UI for consent-control: an opt-in settings page/form and a RichEditor plugin for embedding consent-gated iframes.",
    "keywords": ["laravel", "filament", "consent", "cookie", "gdpr", "privacy"],
    "homepage": "https://github.com/mmoollllee/filament-consent-control",
    "license": "MIT",
    "authors": [
        {
            "name": "Moritz Graf",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "filament/forms": "^5.0",
        "filament/support": "^5.0",
        "mmoollllee/laravel-consent-control": "^0.1",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.5|^10.0",
        "pestphp/pest": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "Mmoollllee\\FilamentConsentControl\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mmoollllee\\FilamentConsentControl\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mmoollllee\\FilamentConsentControl\\ConsentControlServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
