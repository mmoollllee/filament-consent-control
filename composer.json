{
    "name": "mmoollllee/filament-consent-control",
    "description": "Cookie consent banner and content blocking for Laravel Filament with AlpineJS",
    "keywords": ["laravel", "filament", "consent", "cookie", "gdpr", "privacy", "alpine"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "filament/support": "^5.0",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/support": "^11.28|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Mmoollllee\\FilamentConsentControl\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mmoollllee\\FilamentConsentControl\\ConsentControlServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
